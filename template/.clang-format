# Owned by the project template (cs-project-template): change it there.
# The C++ style of every cscosine repository; see https://clang.llvm.org/docs/ClangFormatStyleOptions.html
---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

ColumnLimit: 135

AccessModifierOffset: -2
IndentWidth: 2
UseTab: Never

AlignEscapedNewlines: Left
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty
BreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeComma
IndentPPDirectives: None
PointerAlignment: Left

# csCore's OpenMP macro CS_OMP(...) is written like a #pragma and its arguments contain "for": formatted as if it were
# empty, otherwise the statement after it loses its indentation
Macros: ['CS_OMP(x)=']
